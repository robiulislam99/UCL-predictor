rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /predictions/{uid} {
      // Anyone with the link can view a prediction card (that's the share feature).
      allow read: if true;
      // Only the signed-in owner can create/update their own card.
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
