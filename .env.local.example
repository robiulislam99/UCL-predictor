# Copy this file to .env.local for local development, then fill in the values.
# Get them from Firebase Console → Project settings → General → Your apps → Web app.
# Never commit .env.local (it is gitignored).

NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Set to "true" to use the local Firebase Emulator Suite instead of a real
# project (see README, "Or against the Firebase emulators").
NEXT_PUBLIC_FIREBASE_EMULATORS=

# Leave empty for local dev. The GitHub Actions build sets it from the
# repo's Pages settings (see .github/workflows/deploy.yml).
NEXT_PUBLIC_BASE_PATH=
