# Copy this file to .env.local for local development, then fill in the values.
# Get them from Firebase Console → Project settings → General → Your apps → Web app.
# Never commit .env.local (it is gitignored).

NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Leave empty for local dev. Set to "/your-repo-name" only in the
# GitHub Actions build (already wired up in .github/workflows/deploy.yml).
NEXT_PUBLIC_BASE_PATH=
